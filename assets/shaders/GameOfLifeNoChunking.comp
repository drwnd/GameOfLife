#version 460 core

layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout (r32ui, binding = 0) writeonly restrict uniform uimage2D destination;
layout (r32ui, binding = 1) readonly restrict uniform uimage2D source;

uniform int mask;

const uint[32] TOP_LEFT = uint[32](0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x8, 0x0, 0x0, 0x0);
const uint[32] TOP = uint[32](0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x3, 0x7, 0xe, 0xc);
const uint[32] TOP_RIGHT = uint[32](0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x1);
const uint[32] LEFT = uint[32](0x88, 0x0, 0x0, 0x0, 0x888, 0x0, 0x0, 0x0, 0x8880, 0x0, 0x0, 0x0, 0x88800, 0x0, 0x0, 0x0, 0x888000, 0x0, 0x0, 0x0, 0x8880000, 0x0, 0x0, 0x0, 0x88800000, 0x0, 0x0, 0x0, 0x88000000, 0x0, 0x0, 0x0);
const uint[32] CENTER = uint[32](0x32, 0x75, 0xea, 0xc4, 0x323, 0x757, 0xeae, 0xc4c, 0x3230, 0x7570, 0xeae0, 0xc4c0, 0x32300, 0x75700, 0xeae00, 0xc4c00, 0x323000, 0x757000, 0xeae000, 0xc4c000, 0x3230000, 0x7570000, 0xeae0000, 0xc4c0000, 0x32300000, 0x75700000, 0xeae00000, 0xc4c00000, 0x23000000, 0x57000000, 0xae000000, 0x4c000000);
const uint[32] RIGHT = uint[32](0x0, 0x0, 0x0, 0x11, 0x0, 0x0, 0x0, 0x111, 0x0, 0x0, 0x0, 0x1110, 0x0, 0x0, 0x0, 0x11100, 0x0, 0x0, 0x0, 0x111000, 0x0, 0x0, 0x0, 0x1110000, 0x0, 0x0, 0x0, 0x11100000, 0x0, 0x0, 0x0, 0x11000000);
const uint[32] BOTTOM_LEFT = uint[32](0x80000000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0);
const uint[32] BOTTOM = uint[32](0x30000000, 0x70000000, 0xe0000000, 0xc0000000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0);
const uint[32] BOTTOM_RIGHT = uint[32](0x0, 0x0, 0x0, 0x10000000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0);

struct Region {
    uint topLeft;
    uint top;
    uint topRight;
    uint left;
    uint center;
    uint right;
    uint bottomLeft;
    uint bottom;
    uint bottomRight;
};

uint valueAt(ivec2 position) {
    return imageLoad(source, position & ivec2(mask >> 2, mask >> 3)).r;
}

Region sampleRegion(ivec2 texelCoord) {
    uint topLeft = valueAt(texelCoord + ivec2(-1, 1));
    uint top = valueAt(texelCoord + ivec2(0, 1));
    uint topRight = valueAt(texelCoord + ivec2(1, 1));

    uint left = valueAt(texelCoord + ivec2(-1, 0));
    uint center = valueAt(texelCoord);
    uint right = valueAt(texelCoord + ivec2(1, 0));

    uint bottomLeft = valueAt(texelCoord + ivec2(-1, -1));
    uint bottom = valueAt(texelCoord + ivec2(0, -1));
    uint bottomRight = valueAt(texelCoord + ivec2(1, -1));

    return Region(topLeft, top, topRight, left, center, right, bottomLeft, bottom, bottomRight);
}

uint countNeighbors(Region region, uint index) {
    return bitCount(
        region.topLeft & TOP_LEFT[index] |
        region.top & TOP[index] |
        region.topRight & TOP_RIGHT[index] |
        region.left & LEFT[index] |
        region.center & CENTER[index] |
        region.right & RIGHT[index] |
        region.bottomLeft & BOTTOM_LEFT[index] |
        region.bottom & BOTTOM[index] |
        region.bottomRight & BOTTOM_RIGHT[index]
    );
}


void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    Region region = sampleRegion(texelCoord);
    uint result = 0;

    for (uint index = 0; index < 32; index++) {
        uint counter = (region.center >> index & 1) << 4;
        counter += countNeighbors(region, index);

        result |= (0xc0008 >> counter & 1) << index;
    }

    imageStore(destination, texelCoord, uvec4(result));
}