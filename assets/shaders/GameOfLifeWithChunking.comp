    result |= (0xC0008 >> counter & 1) << 22;

    counter = region.center >> 23 & 1;
    counter <<= 4;
    counter += bitCount(region.center & 0xc4c0000 | region.right & 0x1110000);
    result |= (0xC0008 >> counter & 1) << 23;

    counter = region.center >> 24 & 1;
    counter <<= 4;
    counter += bitCount(region.left & 0x88800000 | region.center & 0x32300000);
    result |= (0xC0008 >> counter & 1) << 24;

    counter = region.center >> 25 & 1;
