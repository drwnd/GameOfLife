    result |= (0xC0008 >> counter & 1) << 13;

    counter = region.center >> 14 & 1;
    counter <<= 4;
    counter += bitCount(region.center & 0xeae00);
    result |= (0xC0008 >> counter & 1) << 14;

    counter = region.center >> 15 & 1;
    counter <<= 4;
    counter += bitCount(region.center & 0xc4c00 | region.right & 0x11100);
    result |= (0xC0008 >> counter & 1) << 15;

    counter = region.center >> 16 & 1;
    counter <<= 4;
    counter += bitCount(region.left & 0x888000 | region.center & 0x323000);
    result |= (0xC0008 >> counter & 1) << 16;

    counter = region.center >> 17 & 1;
    counter <<= 4;
    counter += bitCount(region.center & 0x757000);
    result |= (0xC0008 >> counter & 1) << 17;

    counter = region.center >> 18 & 1;
    counter <<= 4;
    counter += bitCount(region.center & 0xeae000);
    result |= (0xC0008 >> counter & 1) << 18;

    counter = region.center >> 19 & 1;
    counter <<= 4;
    counter += bitCount(region.center & 0xc4c000 | region.right & 0x111000);
    result |= (0xC0008 >> counter & 1) << 19;

    counter = region.center >> 20 & 1;
    counter <<= 4;
    counter += bitCount(region.left & 0x8880000 | region.center & 0x3230000);
    result |= (0xC0008 >> counter & 1) << 20;

    counter = region.center >> 21 & 1;
    counter <<= 4;
    counter += bitCount(region.center & 0x7570000);
    result |= (0xC0008 >> counter & 1) << 21;

    counter = region.center >> 22 & 1;
