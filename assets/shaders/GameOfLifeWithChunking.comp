void main() {
    uint chunkPosition = startPositions[gl_WorkGroupID.x];
    ivec2 texelCoord = ivec2((chunkPosition >> 16) << 4, (chunkPosition & 0xFFFF) << 3) + ivec2(gl_LocalInvocationID.xy);
    Region region = sampleRegion(texelCoord);
    uint oldCenter = region.center;

    if (computeDoubleGeneration) region = computeCenterPadded(region);
    uint result = computeCenter(region);

    imageStore(destination, texelCoord, uvec4(result));
    if (result != oldCenter) imageStore(changedFlagTexture, ivec2(chunkPosition >> 16, chunkPosition & 0xFFFF), uvec4(1));
}