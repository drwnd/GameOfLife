    result |= (0xC0008 >> counter & 1) << 27;

    counter = region.center >> 28 & 1;
    counter <<= 4;
    counter += bitCount(region.topLeft & 0x8 | region.top & 0x3 | region.left & 0x88000000 | region.center & 0x23000000);
    result |= (0xC0008 >> counter & 1) << 28;

    counter = region.center >> 29 & 1;
    counter <<= 4;
    counter += bitCount(region.top & 0x7 | region.center & 0x57000000);
    result |= (0xC0008 >> counter & 1) << 29;

    counter = region.center >> 30 & 1;
    counter <<= 4;
    counter += bitCount(region.top & 0xe | region.center & 0xae000000);
    result |= (0xC0008 >> counter & 1) << 30;

    counter = region.center >> 31 & 1;
    counter <<= 4;
    counter += bitCount(region.top & 0xc | region.topRight & 0x1 | region.center & 0x4c000000 | region.right & 0x11000000);
    result |= (0xC0008 >> counter & 1) << 31;

    return result;
